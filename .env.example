# ==============================================================================
# SUNNYBITE — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your Supabase project credentials.
# You can find these in your Supabase Dashboard under:
# Project Settings -> API -> Project URL & Project API Keys (anon public key)
#
# IMPORTANT SECURITY NOTE:
# ONLY provide the `anon` public key here.
# NEVER use or paste your `service_role` secret key in any client-side file!
# ==============================================================================

# Supabase Project URL (e.g. https://abcdefghijklm.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (starts with eyJhbGciOi...)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
